# ---- OS ----
.DS_Store
Thumbs.db

# ---- Python (Tools/, RosSim/) ----
__pycache__/
*.pyc

# ---- Third-party vendor SDK sources ----
# Large (GB-scale) upstream SDK downloads/extractions. Obtained separately,
# not something we edit. See Deployment/HuskyInsta360/prepare_sdk.ps1 and
# Native/Insta360UnityBridge/build_bridge.bat for how they're consumed.
/Insta360SDK_Source/
/LinuxSDK_Source/

# Docker build context copied in from LinuxSDK_Source by prepare_sdk.ps1 --
# regenerate with that script rather than committing the copies.
/Deployment/HuskyInsta360/sdk/

# Stray native build byproducts left at the repo root by ad-hoc `cl.exe`
# invocations. The real build output that Unity actually uses is
# Assets/Plugins/x86_64/Insta360UnityBridge.dll (tracked via Git LFS below);
# these root-level ones are intermediate junk from build_bridge.bat.
/Insta360UnityBridge.obj
/Insta360UnityBridge.lib
/Insta360UnityBridge.exp

# ---- Vendor plugin binaries ----
# Compiled/redistributed third-party native plugins (Insta360 Camera/Media
# SDK, the OpenCV+CUDA build it depends on, and the KAT VR native SDK).
# Not something we author or want in git history -- obtain from the vendor
# and place at the paths below. .meta files ARE kept in git so the correct
# per-platform import settings apply the moment the real file is dropped in.
# See README.md ("第三方 SDK / Vendor SDKs") for exact versions and sources.
/Assets/Plugins/x86_64/*.dll
/Assets/KAT/SDK/Plugin/Win64/*.dll
/Assets/KAT/SDK/Plugin/Android/*.aar

# ---- Local-only tool settings ----
.claude/settings.local.json
